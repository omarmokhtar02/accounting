# Production template. Copy to the server as .env and fill in real values.
# Never commit the filled-in file; inject secrets from your secret manager.

APP_NAME="Accounting SaaS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.example.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# Behind nginx / a load balancer. Use the proxy IPs, or * only when the app is not reachable directly.
TRUSTED_PROXIES=*

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Connect with a NON-superuser role: PostgreSQL row level security does not apply to superusers.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=accounting
DB_USERNAME=accounting_app
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Used by docker-compose.prod.yml
IMAGE_TAG=latest

# First platform super admin, created by `php artisan db:seed` (password: 12+ characters)
PLATFORM_ADMIN_NAME="Super Admin"
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
